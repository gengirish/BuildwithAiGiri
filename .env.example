# Database — Neon Postgres (used by the app via @neondatabase/serverless AND by Alembic migrations)
# Get this from the Neon console: Project > Connection Details > Connection string (pooled).
# Leave unset to run the app with no DB (submissions are logged + emailed instead of stored).
DATABASE_URL=postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require

# AgentMail
AGENTMAIL_API_KEY=your-agentmail-api-key
AGENTMAIL_INBOX_ID=your-inbox-id
ADMIN_EMAIL=your-email@example.com

# Google OAuth (Gmail + Calendar)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# Admin API key (protect admin routes)
ADMIN_SECRET=your-admin-secret

# Cal.com
NEXT_PUBLIC_CAL_LINK=your-cal-username/mvp-labs
